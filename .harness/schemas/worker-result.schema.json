{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Untrusted worker result, v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "attempt",
    "base_sha",
    "candidate_sha",
    "outcome",
    "changed_files",
    "checks_claimed",
    "blockers",
    "learning_summary_vi"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "base_sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$"
    },
    "candidate_sha": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$"
        },
        {
          "type": "null"
        }
      ]
    },
    "outcome": {
      "enum": [
        "candidate_ready",
        "blocked",
        "failed"
      ]
    },
    "changed_files": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "checks_claimed": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "learning_summary_vi": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "flow",
        "decisions",
        "rerun_commands",
        "self_check_questions"
      ],
      "properties": {
        "flow": {
          "type": "string",
          "minLength": 1
        },
        "decisions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "rerun_commands": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "self_check_questions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    }
  }
}
